#!/usr/bin/env bash
# Model-checks .agents/skills/verify-connection/model/Connection.tla
# with TLC. The model's guard constants are read from the code, so removing a
# guard in the code turns its constant FALSE and the check shows what breaks.
set -euo pipefail

# The latest stable tla2tools.jar release. Upstream's v1.8.0 and rolling tags
# are prereleases whose jar is replaced on each build, so a checksum of either
# goes stale.
TLA_VERSION=1.7.4
TLA_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88

# The tailscale.com version whose daemon behavior the model describes.
MODELED_TAILSCALE=v1.104.4

# Properties the current code is known to break, as PROPERTY:CONSTANT.
# The property must hold with the CONSTANT FALSE and is expected to fail
# with it TRUE. Remove an entry once the code is fixed and the check passes it.
KNOWN_FINDINGS=(LoginSeesBrowseURL:LoginWaitsAfterStart)

PROPERTIES=(OfflineIdleAndCleared NeedsAuthPromptsLogin LoginSeesBrowseURL SetRunningHoldReleases DaemonReconnectResyncs NoDeadlock)

ONLY=
if [[ ${1:-} == --only ]]; then
  ONLY=${2:?usage: check-connection [--only PROPERTY]}
fi

ROOT=$(git rev-parse --show-toplevel)
SKILL_DIR="$ROOT/.agents/skills/verify-connection"
OUT="$SKILL_DIR/out"
WORKERS=${TLC_WORKERS:-auto}

die() { echo "error: $*" >&2; exit 2; }

command -v java >/dev/null || die "java not found. Install a JDK 11 or newer (for example: mise exec java@temurin-21 -- $0)."
command -v perl >/dev/null || die "perl not found."

JAR=${TLA2TOOLS_JAR:-"${XDG_CACHE_HOME:-$HOME/.cache}/trayscale/tla2tools-$TLA_VERSION.jar"}
if [[ ! -f "$JAR" ]]; then
  mkdir -p "$(dirname "$JAR")"
  echo "downloading tla2tools.jar $TLA_VERSION to $JAR"
  curl -fsSL -o "$JAR.part" "https://github.com/tlaplus/tlaplus/releases/download/v$TLA_VERSION/tla2tools.jar"
  mv "$JAR.part" "$JAR"
fi
if command -v sha256sum >/dev/null; then
  sum=$(sha256sum "$JAR" | cut -d' ' -f1)
else
  sum=$(shasum -a 256 "$JAR" | cut -d' ' -f1)
fi
[[ "$sum" == "$TLA_SHA256" ]] || die "$JAR has sha256 $sum, expected $TLA_SHA256. Delete it and rerun."

ts=$(sed -n 's/^[[:space:]]*tailscale\.com \(v[^[:space:]]*\).*/\1/p' "$ROOT/go.mod" | head -n1)
if [[ $ts != "$MODELED_TAILSCALE" ]]; then
  echo "warning: go.mod has tailscale.com $ts, but the model describes $MODELED_TAILSCALE. Recheck the ll: and lapi: actions in the model against $ts, then update MODELED_TAILSCALE."
fi

# anchor FILE REGEX: TRUE when REGEX (Perl, /s) matches FILE.
anchor() {
  perl -0777 -ne "exit(/$2/s ? 0 : 1)" "$ROOT/$1" && echo TRUE || echo FALSE
}
all() { local v; for v in "$@"; do [[ $v == TRUE ]] || { echo FALSE; return; }; done; echo TRUE; }

# One regex per model constant. A FALSE means the guard is gone from the code,
# or the code moved and the regex needs updating. SKILL.md says how to tell.
APP=internal/ui/app.go
BUS=internal/tsutil/bus.go
WIN=internal/ui/mainwindow.go
POLL=internal/tsutil/poller.go
FILES=internal/tsutil/files.go
FUNC_BODY='(?:(?!\n\}\n).)*?'
FLAG_NAMES=()
flag() { FLAG_NAMES+=("$1"); printf -v "FLAG_$1" %s "$2"; }

flag OfflineClearsEngine "$(anchor $APP 'a\.waiting = nil\s*a\.engine = nil')"
flag OfflineClearsWaiting "$(anchor $APP 'if !online \{\s*\/\/[^\n]*\n\s*a\.waiting = nil')"
flag OfflineIgnoresEngine "$(anchor $APP 'case \*tsutil\.EngineStatus:\s*\/\/[^\n]*\n(?:\s*\/\/[^\n]*\n)*\s*if !a\.online \{\s*return')"
flag WindowClearsEngine "$(anchor $WIN 'if !status\.Online\(\) \{\s*\/\/[^\n]*\n\s*win\.engine = nil')"
flag NeedsAuthPrompts "$(all \
  "$(anchor $APP 'func \(a \*App\) setRunning\('"$FUNC_BODY"'if status\.NeedsAuth\(\) \{\s*gutil\.IdleAdd\(func\(\) \{\s*Confirmation\{')" \
  "$(anchor $APP 'if accept \{\s*a\.app\.ActivateAction\("login", nil\)')" \
  "$(anchor $POLL 'func \(s \*IPNStatus\) NeedsAuth\(\) bool \{\s*return s\.State == ipn\.NeedsLogin')")"
flag LoginWaitsAfterStart "$(anchor $APP 'err = tsutil\.StartLogin\(ctx\)\s*if err != nil \{\s*slog\.Error\("failed to start login", "err", err\)\s*fail\(\)\s*return\s*\}\s*for \{\s*status, err := a\.bus\.Next\(ctx\)')"
flag SetRunningHolds "$(all \
  "$(anchor $BUS 'func \(b \*Bus\) SetRunning\('"$FUNC_BODY"'case b\.holds <- 1:')" \
  "$(anchor $BUS 'select \{\s*case <-b\.stopped:\s*case b\.holds <- -1:')" \
  "$(anchor $BUS 'if pending != nil && holds == 0 \{\s*b\.publish\(pending\)')")"
flag SetRunningResendsOnFail "$(anchor $BUS 'if err != nil \{\s*select \{\s*case b\.resend <- struct\{\}\{\}:')"
flag WatchSendsNoState "$(anchor $BUS 'if connected \|\| !down \{\s*\/\/[^\n]*\n(?:\s*\/\/[^\n]*\n)*\s*down = true\s*if !send\(busEvent\{status: IPNStatus\{State: ipn\.NoState\}\.copy\(\)\}\)')"
flag FilesGatedOnline "$(all \
  "$(anchor $FILES 'func \(r \*filesRun\) online\(\) bool \{\s*latest := r\.f\.Bus\.latest\.Load\(\)\s*return latest != nil && latest\.Online\(\)')" \
  "$(anchor $FILES 'if !r\.online\(\)')")"

echo "code facts (model constants):"
for k in "${FLAG_NAMES[@]}"; do
  v="FLAG_$k"; printf '  %-26s %s\n' "$k" "${!v}"
done

rm -rf "$OUT" && mkdir -p "$OUT"
cp "$SKILL_DIR/model/Connection.tla" "$OUT/"

# write_cfg NAME OVERRIDES INVARIANTS...
# OVERRIDES is a comma-separated list of CONSTANT=VALUE, or empty.
write_cfg() {
  local name=$1 overrides=$2; shift 2
  {
    echo "SPECIFICATION Spec"
    echo "CONSTANTS"
    echo "  MaxToggles = 2"
    echo "  MaxLogins = 2"
    echo "  MaxDrops = 1"
    echo "  MaxEngine = 1"
    echo "  MaxFiles = 1"
    echo "  AtomicUI = FALSE"
    declare -A ov=()
    if [[ -n $overrides ]]; then
      local pair
      IFS=',' read -ra pairs <<<"$overrides"
      for pair in "${pairs[@]}"; do
        ov[${pair%%=*}]=${pair#*=}
      done
    fi
    local k v
    for k in "${FLAG_NAMES[@]}"; do
      v="FLAG_$k"
      echo "  $k = ${ov[$k]:-${!v}}"
    done
    echo "CHECK_DEADLOCK FALSE"
    echo "INVARIANT TypeOK $*"
  } >"$OUT/$name.cfg"
}

# run NAME OVERRIDES INVARIANTS...: prints the violated invariant,
# "none", or "tool-error".
run() {
  local name=$1; shift
  write_cfg "$name" "$@"
  (cd "$OUT" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -config "$name.cfg" \
    -workers "$WORKERS" -metadir "$OUT/meta-$name" -nowarning Connection.tla) >"$OUT/$name.out" 2>&1 || true
  if grep -q '^Model checking completed. No error has been found.' "$OUT/$name.out"; then
    echo none
  elif v=$(grep -oE '^Error: Invariant [A-Za-z]+ is violated' "$OUT/$name.out" | awk '{print $3}'); [[ -n $v ]]; then
    echo "$v"
  else
    echo tool-error
  fi
}

if [[ -n $ONLY ]]; then KNOWN_FINDINGS=(); fi
is_known() { local x; for x in "${KNOWN_FINDINGS[@]}"; do [[ ${x%%:*} == "$1" ]] && return 0; done; return 1; }

expected=()
for p in "${PROPERTIES[@]}"; do is_known "$p" || expected+=("$p"); done
[[ -n $ONLY ]] && expected=("$ONLY")

status=0
start=$SECONDS
result=$(run main "" "${expected[@]}")
case $result in
  none) echo "PASS  ${expected[*]}" ;;
  tool-error) echo "TOOL ERROR, see $OUT/main.out"; status=2 ;;
  *) echo "FAIL  $result (counterexample: $OUT/main.out)"; status=1 ;;
esac

for entry in "${KNOWN_FINDINGS[@]}"; do
  f=${entry%%:*} bound=${entry#*:}
  r=$(run "$f-without-$bound" "$bound=FALSE" "$f")
  case $r in
    none) echo "PASS  $f with $bound FALSE" ;;
    tool-error) echo "TOOL ERROR, see $OUT/$f-without-$bound.out"; status=2 ;;
    *) echo "FAIL  $r with $bound FALSE (counterexample: $OUT/$f-without-$bound.out)"; [[ $status == 0 ]] && status=1 ;;
  esac
  r=$(run "$f" "$bound=TRUE" "$f")
  case $r in
    "$f") echo "KNOWN FINDING still present: $f with $bound TRUE (counterexample: $OUT/$f.out)" ;;
    none) echo "FIXED? $f now passes with $bound TRUE. Confirm the fix with a test, then remove it from KNOWN_FINDINGS and the findings in SKILL.md."; status=1 ;;
    tool-error) echo "TOOL ERROR, see $OUT/$f.out"; status=2 ;;
    *) echo "FAIL  $r while checking $f (counterexample: $OUT/$f.out)"; [[ $status == 0 ]] && status=1 ;;
  esac
done
echo "model checked in $((SECONDS - start))s"

# Coverage drift: covered code changed since the sync commit in SKILL.md.
sync=$(sed -n 's/^Sync commit: `\([0-9a-f]*\)`.*/\1/p' "$SKILL_DIR/SKILL.md")
covered=$(sed -n 's/^- `\([^`]*\)`:.*/\1/p' "$SKILL_DIR/SKILL.md" | sort -u)
if [[ -n $sync ]] && git -C "$ROOT" cat-file -e "$sync^{commit}" 2>/dev/null; then
  # shellcheck disable=SC2086
  drift=$(cd "$ROOT" && git diff --name-only "$sync" -- $covered)
  if [[ -n $drift ]]; then
    echo "covered code changed since sync commit $sync, so recheck the model against it:"
    echo "$drift" | sed 's/^/  /'
  fi
else
  echo "warning: sync commit '$sync' from SKILL.md is not in this clone; cannot check coverage drift."
fi

exit $status
