# LeakSanitizer suppressions for go test -asan.
#
# Only library-internal caches that are intentionally kept until
# process exit belong here. Never suppress a frame from our own code or
# from the puregotk/purego bindings.

# Fontconfig's parsed configuration and font sets, cached by pango.
leak:libfontconfig.so
# Pango's font map and layout caches.
leak:libpango-1.0.so
leak:libpangoft2-1.0.so

